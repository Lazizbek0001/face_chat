# Copy this file to .env and fill in real values. Never commit .env.

# From https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Authentik application for this API (created by authentik/blueprints/face-chat.yaml).
# The issuer ends with a slash.
OIDC_ISSUER=http://localhost:9000/application/o/face-chat/
OIDC_CLIENT_ID=face-chat

# Optional. Defaults to a local SQLite file.
DATABASE_URL=sqlite+aiosqlite:///./test.db
