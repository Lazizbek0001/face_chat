# Copy this file to .env and fill in real values. Never commit .env.

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET=

# From https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Optional. Defaults to a local SQLite file.
DATABASE_URL=sqlite+aiosqlite:///./test.db

# Optional. Set to 1 only in development to allow http:// verify URLs that are not localhost.
# HUB_ALLOW_INSECURE_HTTP=1
