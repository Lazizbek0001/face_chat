# Copy to authentik/.env and fill in. Never commit .env.
# Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

PG_PASS=
AUTHENTIK_SECRET_KEY=

# First admin account (user name "akadmin"). Used only on the first start.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=

AUTHENTIK_ERROR_REPORTING__ENABLED=false

# --- Used by blueprints/face-chat.yaml ---
# Where the face_chat API runs (its /docs page logs in through Authentik).
FACE_CHAT_URL=http://localhost:8000
# Where the sample website runs, and its client secret (same value as in examples/sample_site/.env).
SAMPLE_SITE_URL=http://localhost:8001
SAMPLE_SITE_CLIENT_SECRET=
