# Copy to examples/sample_site/.env. Never commit .env.

SITE_URL=http://localhost:8001

# The Authentik application created by authentik/blueprints/face-chat.yaml. Ends with a slash.
OIDC_ISSUER=http://localhost:9000/application/o/sample-site/
OIDC_CLIENT_ID=sample-site
# Same value as SAMPLE_SITE_CLIENT_SECRET in authentik/.env.
OIDC_CLIENT_SECRET=

# Signs this site's session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
